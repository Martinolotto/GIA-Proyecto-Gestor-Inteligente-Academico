<file path="Frontend/assets/css/style.css">
/*Archivo solo para estilos generales de la pagina u objetos generales */


*{
    margin:0;
    padding:0;
    box-sizing:border-box;
}

/* ==================================================
   CONFIGURACIÓN GENERAL DEL SITIO
   --------------------------------------------------
   Se define un fondo global reutilizable para todo
   el sitio.

   Esto permite que todas las secciones compartan
   la misma identidad visual sin repetir imágenes.
=================================================== */

body{

    font-family:'Plus Jakarta Sans',sans-serif;

    background:

        #F4F6F9

        url("../img/background-index.png")

        center top

        repeat-y;

    background-size:cover;

    color:#223047;
}
/* ==================================================
   CONTENEDORES PRINCIPALES

   Evita que las secciones agreguen fondos blancos
   sólidos que oculten el fondo global.
=================================================== */

section{

    position:relative;

    z-index:1;
}




/* NAVBAR */
.gia-navbar{

    background:#2F3438;

    min-height:74px;

    border-bottom:1px solid rgba(255,255,255,.07);

    box-shadow:
    0 1px 0 rgba(255,255,255,.03),
    0 8px 30px rgba(0,0,0,.12);
}

/* LOGO */
.gia-logo{
    width:120px;

    filter:brightness(0) invert(1);
}

/* LINKS */
.gia-navbar .nav-link{

    color:#c4cbd2;

    font-weight:600;

    padding:.75rem 1rem !important;

    position:relative;

    transition:.2s;
}

.gia-navbar .nav-link:hover{

    color:white;
}

.gia-navbar .nav-link.active{

    color:white;
}

.gia-navbar .nav-link::after{

    content:"";

    position:absolute;

    left:16px;
    right:16px;
    bottom:6px;

    height:2px;

    background:#F96B25;

    transform:scaleX(0);

    transition:.25s;
}

.gia-navbar .nav-link:hover::after,
.gia-navbar .nav-link.active::after{

    transform:scaleX(1);
}

/* ==================================================
   BUSCADOR DEL NAVBAR
=================================================== */

.gia-search{

    display:flex;

    align-items:center;

    width:100%;
    max-width:520px;

    height:46px;

    background:#3A4045;

    border:1px solid rgba(255,255,255,.08);

    border-radius:14px;

    overflow:hidden;

    transition:.25s;
}

.gia-search:focus-within{

    border-color:#F96B25;

    box-shadow:
        0 0 0 4px rgba(249,107,37,.12);
}
.gia-search input{

    flex:1;

    min-width:0;

    border:none;
    outline:none;

    background:transparent;

    color:white;

    font-size:.92rem;

    padding-right:12px;
}

.gia-search input::placeholder{

    color:#8d98a3;
}

.gia-search-icon{

    width:18px;
    height:18px;

    stroke:#8d98a3;

    stroke-width:2;

    margin:0 12px;

    flex-shrink:0;
}

/* ==================================================
   BOTÓN DEL BUSCADOR
=================================================== */

.gia-search-btn{

    height:100%;

    border:none;

    padding:0 22px;

    background:#F96B25;

    color:white;

    font-weight:700;

    font-size:.88rem;

    cursor:pointer;

    transition:.25s;

    flex-shrink:0;
}

.gia-search-btn:hover{

    background:#EA5F1D;
}


/* TRUST */

.gia-trust{

    align-items:center;

    gap:8px;

    margin-left:20px;

    color:#b6bec6;

    font-size:.82rem;

    white-space:nowrap;
}

.gia-dot{

    width:8px;
    height:8px;

    background:#4ADE80;

    border-radius:50%;
}

/* AUTH */

.gia-auth{

    display:flex;

    align-items:center;

    gap:16px;

    margin-left:24px;
}

.gia-login{

    text-decoration:none;

    color:#d7dde3;

    font-weight:600;

    transition:.2s;
}

.gia-login:hover{

    color:white;
}

.gia-register{

    text-decoration:none;

    background:#F96B25;

    color:white;

    padding:11px 18px;

    border-radius:12px;

    font-weight:700;

    transition:.25s;
}

.gia-register:hover{

    background:#ea5f1d;

    transform:translateY(-1px);

    color:white;
}

/* MOBILE */

.gia-toggler{

    border:none !important;

    box-shadow:none !important;
}

.gia-toggler .navbar-toggler-icon{

    filter:invert(1);
}

@media (max-width:991px){

    .gia-search{

        max-width:none;

        margin-top:16px;
    }

    .gia-auth{

        margin-left:0;

        margin-top:20px;

        flex-direction:column;

        align-items:stretch;
    }

    .gia-login{

        text-align:center;
    }

    .gia-register{

        text-align:center;
    }

    .navbar-nav{

        margin-top:15px;
    }
}








/* ==================================================
   FOOTER GIA
=================================================== */

.footer-gia{

    background:#25292D;

    color:#FFFFFF;

    margin-top:120px;
}


/* ==================================================
