/* ==================================================
   HERO PRINCIPAL
   ==================================================

   Esta sección es la primera impresión de GIA.

   Objetivos:
   - Comunicar la propuesta de valor.
   - Generar confianza.
   - Mantener legibilidad sobre la imagen.
   - Adaptarse a dispositivos móviles.

=================================================== */

.hero-gia{

    position: relative;

    min-height: 720px;

    display: flex;
    align-items: center;

    overflow: hidden;

    /* Imagen principal */

    background-image:
        url("../../img/hero-estudiantes-saliendo.img");

    background-size: cover;

    background-position: center center;

    background-repeat: no-repeat;
}


/* ==================================================
   CAPA OSCURA DE SUPERPOSICIÓN
   --------------------------------------------------
   Oscurece solamente el lado izquierdo.
   Mantiene visible la fotografía.
=================================================== */

.hero-overlay{

    position: absolute;

    inset: 0;

    background:

    linear-gradient(

        90deg,

        rgba(47,52,56,.95) 0%,

        rgba(47,52,56,.82) 25%,

        rgba(47,52,56,.55) 45%,

        rgba(47,52,56,.20) 65%,

        rgba(47,52,56,0) 100%

    );
}


/* ==================================================
   CONTENIDO DEL HERO
=================================================== */

.hero-contenido{

    position: relative;

    z-index: 2;

    max-width: 700px;
}


/* ==================================================
   ETIQUETA SUPERIOR
=================================================== */

.hero-badge{

    display: inline-block;

    padding: 8px 16px;

    border-radius: 999px;

    background: rgba(249,107,37,.15);

    border: 1px solid rgba(249,107,37,.25);

    color: #F96B25;

    font-size: .85rem;

    font-weight: 700;
}


/* ==================================================
   TÍTULO PRINCIPAL
=================================================== */

.hero-titulo{

    margin-top: 22px;

    color: #FFFFFF;

    font-size: 4rem;

    font-weight: 800;

    line-height: 1.1;

    text-shadow:

        0 2px 10px rgba(0,0,0,.30);
}


/* ==================================================
   DESCRIPCIÓN
=================================================== */

.hero-descripcion{

    margin-top: 24px;

    max-width: 600px;

    color: rgba(255,255,255,.85);

    font-size: 1.15rem;

    line-height: 1.8;
}


/* ==================================================
   BOTONES
=================================================== */

.hero-botones{

    display: flex;

    flex-wrap: wrap;

    gap: 14px;

    margin-top: 35px;
}


/* Botón principal */

.btn-gia-principal{

    text-decoration: none;

    background: #F96B25;

    color: #FFFFFF;

    padding: 14px 24px;

    border-radius: 12px;

    font-weight: 700;

    transition: .25s;
}

.btn-gia-principal:hover{

    background: #E85E1D;

    transform: translateY(-2px);

    color: #FFFFFF;
}


/* Botón secundario */

.btn-gia-secundario{

    text-decoration: none;

    padding: 14px 24px;

    border-radius: 12px;

    border: 1px solid rgba(255,255,255,.25);

    color: #FFFFFF;

    font-weight: 600;

    transition: .25s;
}

.btn-gia-secundario:hover{

    background: rgba(255,255,255,.08);

    color: #FFFFFF;
}


/* ==================================================
   BENEFICIOS DEL HERO
=================================================== */

.hero-beneficios{

    display:flex;

    flex-wrap:wrap;

    gap:28px;

    margin-top:50px;
}

.beneficio{

    display:flex;

    align-items:center;

    gap:10px;

    color:rgba(255,255,255,.92);

    font-weight:600;

    font-size:.95rem;
}

.beneficio-icono{

    display:flex;

    justify-content:center;

    align-items:center;

    width:26px;
    height:26px;

    border-radius:50%;

    background:rgba(249,107,37,.15);

    color:#F96B25;

    font-weight:700;

    flex-shrink:0;
}

/* ==================================================
   RESPONSIVE - TABLET
=================================================== */

@media (max-width: 992px){

    .hero-gia{

        min-height: 650px;
    }

    .hero-titulo{

        font-size: 3rem;
    }

    .hero-overlay{

        background:

        linear-gradient(

            90deg,

            rgba(47,52,56,.92) 0%,

            rgba(47,52,56,.80) 50%,

            rgba(47,52,56,.55) 100%

        );
    }
}


/* ==================================================
   RESPONSIVE - MÓVIL
=================================================== */

@media (max-width: 576px){

    .hero-gia{

        min-height: 650px;
    }

    .hero-titulo{

        font-size: 2.3rem;
    }

    .hero-descripcion{

        font-size: 1rem;
    }

    .hero-estadisticas{

        gap: 20px;
    }

    .hero-overlay{

        background:

        rgba(47,52,56,.82);
    }
}
</file>

